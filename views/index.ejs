<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bike Weather Checker</title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>

    <main>
        <h1>Bike Weather Checker</h1>

        <p>
            Enter your latitude and longitude to see if the current
            weather is suitable for a bike ride.
        </p>

        <form action="/weather" method="POST">

            <div>
                <label for="latitude">Latitude</label>
                <input
                    type="number"
                    id="latitude"
                    name="latitude"
                    step="any"
                    min="-90"
                    max="90"
                    required
                >
            </div>

            <div>
                <label for="longitude">Longitude</label>
                <input
                    type="number"
                    id="longitude"
                    name="longitude"
                    step="any"
                    min="-180"
                    max="180"
                    required
                >
            </div>

            <button type="submit">Check Riding Conditions</button>

        </form>
        <% if (temperature !== undefined) { %>

            <h2><%= recommendation %></h2>

            <p>Temperature: <%= temperature %> °F</p>
            <p>Precipitation: <%= precipitation %> mm</p>
            <p>Wind Speed: <%= windSpeed %> mph</p>

        <% } %>
    </main>

</body>
</html>